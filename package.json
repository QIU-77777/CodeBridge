{
  "name": "opencode-feishu-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "飞书机器人桥接本地 opencode serve，支持多会话切换与流式输出",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "admin": "node admin/server.js",
    "init": "node scripts/init.mjs",
    "test:init": "node scripts/test-init.mjs",
    "test:identity": "node scripts/test-feishu-identity.mjs",
    "test:pi": "node scripts/test-pi.mjs",
    "test:pi-cli-sessions": "node scripts/test-pi-cli-sessions.mjs",
    "test:patch": "node scripts/test-patch-order.mjs",
    "test:github": "node scripts/test-github-app.mjs",
    "test:admin": "node scripts/test-admin.mjs && node scripts/test-admin-api.mjs",
    "test:busy": "node scripts/test-busy.mjs",
    "test:cmd-route": "node scripts/test-cmd-route.mjs",
    "test:runfail": "node scripts/test-runfail.mjs",
    "test:errors": "node scripts/test-errors.mjs",
    "test:topic-context": "node scripts/test-topic-context.mjs",
    "test:wedge": "node scripts/test-wedge.mjs",
    "test:render": "node scripts/test-render.mjs",
    "test:serve-password": "node scripts/test-serve-password.mjs",
    "dry": "node src/index.js --dry",
    "selftest": "node scripts/selftest.mjs",
    "doctor": "node scripts/doctor.mjs",
    "status": "bash scripts/status.sh",
    "up": "bash scripts/up.sh",
    "down": "bash scripts/down.sh",
    "probe:names": "node scripts/probe-names.mjs",
    "probe:msg": "node scripts/probe-msg.mjs",
    "probe:prompt": "node scripts/probe-prompt.mjs"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0"
  }
}
